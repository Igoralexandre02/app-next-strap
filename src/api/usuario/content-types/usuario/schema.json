{
  "kind": "collectionType",
  "collectionName": "usuarios",
  "info": {
    "singularName": "usuario",
    "pluralName": "usuarios",
    "displayName": "Usuario"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Nome": {
      "type": "string",
      "required": true
    },
    "CPF": {
      "type": "string",
      "minLength": 11,
      "maxLength": 11,
      "required": true,
      "unique": true,
      "regex": "^[0-9]{11}$"
    },
    "Senha": {
      "type": "password",
      "required": true
    }
  }
}
