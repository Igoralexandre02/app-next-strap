{
  "kind": "collectionType",
  "collectionName": "agendamentos",
  "info": {
    "singularName": "agendamento",
    "pluralName": "agendamentos",
    "displayName": "Agendamento"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "nome": {
      "type": "string",
      "required": true
    },
    "data": {
      "type": "date",
      "required": true
    },
    "horario": {
      "type": "time",
      "required": true,
      "default": "00:00:00.000"
    },
    "numero": {
      "type": "string",
      "required": true
    },
    "status_id": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::status.status",
      "required": true
    }
  }
}
